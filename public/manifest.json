{
    "manifest_version": 3,
    "name": "SSH Keytool",
    "version": "1.3.0",
    "description": "Generate, convert and inspect SSH keys and certificates offline, including FIDO security keys (ed25519-sk / ecdsa-sk).",
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "permissions": [
        "clipboardWrite"
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "author": "mkontani"
}